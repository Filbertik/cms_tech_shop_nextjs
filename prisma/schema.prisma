generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id String @id
  title String
  price Float
  stock Int
  slug String?
  description String?
  createdAt DateTime
  updatedAt DateTime?
  images Image[]
}

model Image {
  id String @id
  url String
  productId String
}